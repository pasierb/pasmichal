---
import { Image } from "astro:assets";
import profilePic from "../assets/images/profile_pic.webp";
import TableOfContents from "../components/table-of-contents.astro";
import { SITE } from "../consts";
import { formatDate } from "../lib/date";
import Layout from "./main.astro";

interface Props {
	// biome-ignore lint/suspicious/noExplicitAny: post and podcast entries share this layout
	frontmatter: any;
	headings?: { depth: number; slug: string; text: string }[];
	/** Back-link target. Podcast pages pass /podcasts. */
	backHref?: string;
	backLabel?: string;
	type?: "article" | "website";
	lang?: string;
	/**
	 * Absolute-path social card. Derived by the caller so the same URL feeds
	 * og:image and the JSON-LD without deriving the crop twice. Omit to fall
	 * through to the shared card in seo.astro.
	 */
	ogImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
}

const {
	frontmatter,
	headings = [],
	backHref = "/posts",
	backLabel = "Back to writing",
	type = "article",
	lang = "en",
	ogImage,
	ogImageWidth,
	ogImageHeight,
} = Astro.props;
---

<Layout
  title={frontmatter.seoTitle ?? frontmatter.title}
  description={frontmatter.seoDescription ?? frontmatter.description}
  image={ogImage}
  imageWidth={ogImageWidth}
  imageHeight={ogImageHeight}
  imageAlt={frontmatter.heroImageAlt ?? frontmatter.title}
  canonical={frontmatter.canonicalUrl}
  noindex={frontmatter.noindex}
  type={type}
  publishedTime={frontmatter.pubDate}
  modifiedTime={frontmatter.updatedDate}
  lang={frontmatter.lang ?? lang}
>
  <slot name="meta-tags" slot="meta-tags" />

  <article class="max-w-2xl mx-auto px-7 md:px-0 pt-12 md:pt-16 pb-24">

    <!-- Back link -->
    <p class="mb-12">
      <a
        href={backHref}
        class="font-sans text-sm text-secondary dark:text-secondary-dark hover:text-primary dark:hover:text-primary-dark transition-colors"
      >
        ← {backLabel}
      </a>
    </p>

    <!-- Byline -->
    <div class="flex items-center gap-4 mb-8">
      {/* densities + explicit width/height, and deliberately no `layout`:
          the two are mutually exclusive, and a fixed-size avatar wants
          1x/2x rather than a responsive srcset. */}
      <Image
        src={profilePic}
        alt=""
        width={56}
        height={56}
        densities={[1, 2]}
        format="webp"
        quality={82}
        loading="eager"
        decoding="async"
        class="w-14 h-14 rounded-full object-cover shrink-0"
      />
      <div class="flex flex-col leading-tight">
        <span class="font-sans text-base text-primary dark:text-primary-dark">
          {SITE.name}
        </span>
        <time
          datetime={frontmatter.pubDate.toISOString()}
          class="font-sans text-sm text-muted dark:text-muted-dark mt-1"
        >
          {formatDate(frontmatter.pubDate)}
        </time>
      </div>
    </div>

    <!-- Page header -->
    <header class="mb-12">
      <h1 class="font-serif text-3xl md:text-5xl leading-[1.1] text-primary dark:text-primary-dark">
        {frontmatter.title}
      </h1>
      <p class="font-sans text-base md:text-lg leading-relaxed text-secondary dark:text-secondary-dark mt-5">
        {frontmatter.description}
      </p>
    </header>

    {
      frontmatter.heroImage && (
        <figure class="mb-12">
          {/* `priority` sets loading=eager + decoding=sync + fetchpriority=high.
              width + layout="constrained" derive height from the source aspect
              ratio, so the <img> ships real dimensions and CLS goes to zero.
              The container is max-w-2xl px-7 md:px-0 -> 672px from `md:`. */}
          <Image
            src={frontmatter.heroImage}
            alt={frontmatter.heroImageAlt ?? ""}
            layout="constrained"
            width={672}
            widths={[672, 1008, 1344]}
            sizes="(min-width: 768px) 672px, calc(100vw - 3.5rem)"
            format="webp"
            quality={80}
            priority
            class="w-full rounded-md"
          />
        </figure>
      )
    }

    {frontmatter.toc && <TableOfContents headings={headings} />}

    <div class="prose prose-sm lg:prose-lg dark:prose-invert">
      <slot />
    </div>

  </article>
</Layout>
