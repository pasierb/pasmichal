---
import { Image } from "astro:assets";
import profilePic from "../assets/images/profile_pic.webp";
import TableOfContents from "../components/table-of-contents.astro";
import { SITE } from "../consts";
import { formatDate } from "../lib/date";
import Layout from "./main.astro";

interface Props {
	// biome-ignore lint/suspicious/noExplicitAny: post and podcast entries share this layout
	frontmatter: any;
	headings?: { depth: number; slug: string; text: string }[];
	/** Back-link target. Podcast pages pass /podcasts. */
	backHref?: string;
	backLabel?: string;
	type?: "article" | "website";
	lang?: string;
	/**
	 * Absolute-path social card. Derived by the caller so the same URL feeds
	 * og:image and the JSON-LD without deriving the crop twice. Omit to fall
	 * through to the shared card in seo.astro.
	 */
	ogImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
}

const {
	frontmatter,
	headings = [],
	backHref = "/posts",
	backLabel = "Back to writing",
	type = "article",
	lang = "en",
	ogImage,
	ogImageWidth,
	ogImageHeight,
} = Astro.props;
---

<Layout
  title={frontmatter.seoTitle ?? frontmatter.title}
  description={frontmatter.seoDescription ?? frontmatter.description}
  image={ogImage}
  imageWidth={ogImageWidth}
  imageHeight={ogImageHeight}
  imageAlt={frontmatter.heroImageAlt ?? frontmatter.title}
  canonical={frontmatter.canonicalUrl}
  noindex={frontmatter.noindex}
  type={type}
  publishedTime={frontmatter.pubDate}
  modifiedTime={frontmatter.updatedDate}
  lang={frontmatter.lang ?? lang}
>
  <slot name="meta-tags" slot="meta-tags" />

  <article class="w-full max-w-[860px] mx-auto px-6 md:px-12 py-12 md:py-20 flex flex-col gap-10">

    <!-- Back link -->
    <div>
      <a
        href={backHref}
        class="font-label-mono text-label-mono text-secondary dark:text-secondary-dark hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark px-2 py-1 -ml-2 transition-colors inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark"
      >
        ← {backLabel}
      </a>
    </div>

    <!-- Page header -->
    <header class="flex flex-col gap-4">
      <h1 class="font-headline-xl-mobile md:font-headline-lg text-primary dark:text-primary-dark font-semibold">
        {frontmatter.title}
      </h1>
      <p class="font-body-lg text-secondary dark:text-secondary-dark">
        {frontmatter.description}
      </p>

      <!-- Byline -->
      <div class="flex items-center gap-4 pt-4 border-t border-border-main dark:border-border-main-dark">
        <Image
          src={profilePic}
          alt=""
          width={48}
          height={48}
          densities={[1, 2]}
          format="webp"
          quality={82}
          loading="eager"
          decoding="async"
          class="w-12 h-12 border border-border-main dark:border-border-main-dark object-cover shrink-0"
        />
        <div class="flex flex-col leading-tight">
          <span class="font-label-mono-bold text-label-mono-bold text-primary dark:text-primary-dark">
            {SITE.name}
          </span>
          <time
            datetime={frontmatter.pubDate.toISOString()}
            class="font-label-mono text-label-mono text-secondary dark:text-secondary-dark mt-0.5"
          >
            {formatDate(frontmatter.pubDate)}
          </time>
        </div>
      </div>

      {/* Imported posts credit */}
      {
        frontmatter.originalUrl && frontmatter.source && (
          <p class="font-label-mono text-xs text-secondary dark:text-secondary-dark mt-2">
            Originally published on{" "}
            <a
              href={frontmatter.originalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="underline hover:text-primary dark:hover:text-primary-dark transition-colors"
            >
              {frontmatter.source}
            </a>
            <span class="ml-1 align-middle text-xs">↗</span>
          </p>
        )
      }
    </header>

    {
      frontmatter.heroImage && (
        <figure class="border border-border-main dark:border-border-main-dark overflow-hidden">
          <Image
            src={frontmatter.heroImage}
            alt={frontmatter.heroImageAlt ?? ""}
            layout="constrained"
            width={860}
            widths={[672, 860, 1200]}
            sizes="(min-width: 860px) 860px, 100vw"
            format="webp"
            quality={85}
            priority
            class="w-full h-auto object-cover"
          />
        </figure>
      )
    }

    {frontmatter.toc && <TableOfContents headings={headings} />}

    <div class="prose prose-neutral dark:prose-invert max-w-none prose-headings:font-sans prose-headings:tracking-tight prose-headings:font-semibold prose-a:text-primary dark:prose-a:text-primary-dark prose-code:font-mono">
      <slot />
    </div>

  </article>
</Layout>
