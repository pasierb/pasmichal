---
import { Picture } from "astro:assets";
import profilePic from "../assets/images/profile_pic.png";
import Layout from "./main.astro";
const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title + " | Michał Pasierbski"}>
  <Fragment slot="meta-tags">
    <!-- Primary Meta Tags -->
    <meta name="title" content={frontmatter.title} />
    <meta name="description" content={frontmatter.description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.url).href}
    />
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:description" content={frontmatter.description} />
    {
      frontmatter.heroImage && (
        <meta
          property="og:image"
          content={new URL(frontmatter.heroImage, Astro.url).href}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:url"
      content={new URL(Astro.url.pathname, Astro.url).href}
    />
    <meta property="twitter:title" content={frontmatter.title} />
    <meta property="twitter:description" content={frontmatter.description} />
    {
      frontmatter.heroImage && (
        <meta
          property="twitter:image"
          content={new URL(frontmatter.heroImage, Astro.url).href}
        />
      )
    }
  </Fragment>

  <article class="max-w-2xl mx-auto px-7 md:px-0 pt-12 md:pt-16 pb-24">

    <!-- Back link -->
    <p class="mb-12">
      <a
        href="/posts"
        class="font-sans text-sm text-secondary dark:text-secondary-dark hover:text-primary dark:hover:text-primary-dark transition-colors"
      >
        ← Back to writing
      </a>
    </p>

    <!-- Byline -->
    <div class="flex items-center gap-4 mb-8">
      <Picture
        src={profilePic}
        alt="Michał Pasierbski"
        widths={[112, 168]}
        sizes="56px"
        formats={["avif", "webp"]}
        class="w-14 h-14 rounded-full object-cover shrink-0"
      />
      <div class="flex flex-col leading-tight">
        <span class="font-sans text-base text-primary dark:text-primary-dark">
          Michał Pasierbski
        </span>
        <span class="font-sans text-sm text-muted dark:text-muted-dark mt-1">
          {frontmatter.dateFormatted}
        </span>
      </div>
    </div>

    <!-- Page header -->
    <header class="mb-12">
      <h1 class="font-serif text-3xl md:text-5xl leading-[1.1] text-primary dark:text-primary-dark">
        {frontmatter.title}
      </h1>
      <p class="font-sans text-base md:text-lg leading-relaxed text-secondary dark:text-secondary-dark mt-5">
        {frontmatter.description}
      </p>
    </header>

    {
      frontmatter.heroImage && (
        <figure class="mb-12">
          <img
            src={frontmatter.heroImage}
            alt={frontmatter.title}
            class="w-full rounded-md"
          />
        </figure>
      )
    }

    <div class="prose prose-sm lg:prose-lg dark:prose-invert">
      <slot />
    </div>

  </article>
</Layout>
