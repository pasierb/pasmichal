---
import { getCollection, render } from "astro:content";
import JsonLd from "../../components/json-ld.astro";
import Layout from "../../layouts/post.astro";
import { breadcrumbs, graph, videoObject } from "../../lib/schema";
import {
	youTubeEmbedUrl,
	youTubeId,
	youTubeThumbnail,
} from "../../lib/youtube";

export async function getStaticPaths() {
	const entries = await getCollection("podcast");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const pathname = `/podcast/${entry.id}`;
const embedUrl = youTubeEmbedUrl(entry.data.link);
// These pages have no hero image of their own, so the YouTube thumbnail gives
// them a real og:image for free.
const thumbnail = youTubeThumbnail(entry.data.link);
---

<Layout
  frontmatter={entry.data}
  backHref="/podcasts"
  backLabel="Back to podcasts"
  type="website"
  ogImage={thumbnail}
  ogImageWidth={1280}
  ogImageHeight={720}
>
  <Fragment slot="meta-tags">
    {/* VideoObject rather than PodcastEpisode: the latter needs a
        PodcastSeries and a feed that do not exist, and the content really is
        a YouTube video. */}
    <JsonLd
      data={graph(
        videoObject({
          name: entry.data.title,
          description: entry.data.description,
          videoId: youTubeId(entry.data.link),
          embedUrl,
          thumbnailUrl: thumbnail,
          uploadDate: entry.data.pubDate,
          pathname,
          duration: entry.data.duration,
          inLanguage: entry.data.lang,
        }),
        breadcrumbs([
          { name: "Home", path: "/" },
          { name: "Podcasts", path: "/podcasts" },
          { name: entry.data.title },
        ]),
      )}
    />
  </Fragment>

  <Content />

  {
    entry.data.type === "youtube" && (
      <iframe
        src={embedUrl}
        title={`${entry.data.title} — video`}
        width="560"
        height="315"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        class="w-full aspect-video h-auto border border-border-main dark:border-border-main-dark mt-6"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      />
    )
  }
</Layout>
