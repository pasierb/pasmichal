---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import profilePic from "../assets/images/profile_pic.webp";
import JsonLd from "../components/json-ld.astro";
import Layout from "../layouts/main.astro";
import { formatMonth } from "../lib/date";
import { graph, person, website } from "../lib/schema";

const sortedPosts = (
	await getCollection("post", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featured = sortedPosts[0];
const recent = sortedPosts.slice(1, 6);

function postHref(post: (typeof sortedPosts)[number]) {
	return post.data.externalUrl ?? `/post/${post.id}`;
}

function isExternal(post: (typeof sortedPosts)[number]) {
	return !!post.data.externalUrl;
}
---

<Layout
  title="Michał Pasierbski | AI Product Engineering"
  rawTitle
  type="profile"
>
  {/* The entity anchor: sameAs + a single @id is what consolidates
      "Michał Pasierbski" into one entity across X, LinkedIn and GitHub. */}
  <Fragment slot="meta-tags">
    <JsonLd data={graph(person(profilePic.src), website())} />
  </Fragment>

  <div class="w-full max-w-[1200px] mx-auto px-6 md:px-12 lg:px-24 py-12 md:py-20 flex flex-col gap-12 md:gap-16">

    <!-- Hero Section -->
    <section class="flex flex-col gap-4 md:gap-6">
      <div class="flex items-center gap-3">
        <h1 class="font-headline-xl-mobile md:font-headline-xl text-primary dark:text-primary-dark max-w-4xl">
          Michał Pasierbski
        </h1>
        <button
          id="pronounce-btn"
          type="button"
          aria-label="Hear my name pronounced"
          class="inline-flex items-center justify-center w-7 h-7 text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark transition-colors cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
          </svg>
        </button>
      </div>
      <p class="font-body-lg text-body-lg text-secondary dark:text-secondary-dark max-w-2xl">
        Leading AI product engineering · Zurich
      </p>
    </section>

    <!-- Latest Essay Callout -->
    {featured && (
      <section>
        <a
          href={postHref(featured)}
          {...(isExternal(featured) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          class="border border-border-main dark:border-border-main-dark p-6 md:p-8 hover:bg-surface-container-low dark:hover:bg-surface-container-low-dark transition-colors duration-200 group cursor-pointer flex flex-col md:flex-row gap-8 items-start block"
        >
          <div class="flex-grow flex flex-col gap-4">
            <span class="font-label-mono text-label-mono text-primary dark:text-primary-dark uppercase border border-border-main dark:border-border-main-dark px-2 py-1 self-start inline-block">
              Latest essay
            </span>
            <h2 class="font-headline-lg text-headline-lg text-primary dark:text-primary-dark group-hover:underline decoration-2 underline-offset-4">
              {featured.data.title}
              {isExternal(featured) && <span class="font-mono text-base text-muted dark:text-muted-dark ml-2">↗</span>}
            </h2>
            <div class="font-label-mono text-label-mono text-secondary dark:text-secondary-dark">
              <time datetime={featured.data.pubDate.toISOString()}>
                {formatMonth(featured.data.pubDate)}
              </time>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant-dark max-w-2xl">
              {featured.data.description}
            </p>
            <div class="font-label-mono-bold text-label-mono-bold text-primary dark:text-primary-dark mt-4 flex items-center gap-1 group-hover:gap-2 transition-all">
              Read on <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
            </div>
          </div>
          {featured.data.heroImage && (
            <div class="w-full md:w-[320px] shrink-0 border border-border-main dark:border-border-main-dark overflow-hidden hidden md:block aspect-[4/3]">
              <Image
                src={featured.data.heroImage}
                alt={featured.data.heroImageAlt ?? ""}
                layout="constrained"
                width={320}
                widths={[320, 640]}
                sizes="(min-width: 768px) 320px, 100vw"
                format="webp"
                quality={80}
                priority
                class="w-full h-full object-cover filter grayscale contrast-125 group-hover:grayscale-0 transition-all duration-500"
              />
            </div>
          )}
        </a>
      </section>
    )}

    <!-- Recent Writing -->
    <section class="flex flex-col gap-6 md:gap-8">
      <div class="flex justify-between items-end border-b border-border-main dark:border-border-main-dark pb-4">
        <h3 class="font-label-mono-bold text-label-mono-bold uppercase tracking-widest text-primary dark:text-primary-dark">
          Recent writing
        </h3>
        <a
          class="font-label-mono text-label-mono text-primary dark:text-primary-dark hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark px-2 py-1 transition-colors"
          href="/posts"
        >
          View all writings →
        </a>
      </div>
      <ul class="flex flex-col gap-5 md:gap-6">
        {recent.map((post) => (
          <li class="group">
            <a
              href={postHref(post)}
              {...(isExternal(post) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-8"
            >
              <time
                datetime={post.data.pubDate.toISOString()}
                class="font-label-mono text-label-mono text-secondary dark:text-secondary-dark w-32 shrink-0"
              >
                {formatMonth(post.data.pubDate)}
              </time>
              <span class="font-body-lg text-body-lg text-primary dark:text-primary-dark group-hover:underline decoration-1 underline-offset-4">
                {post.data.title}
                {isExternal(post) && <span class="font-mono text-xs text-muted dark:text-muted-dark ml-1.5 align-middle">↗</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Also Section -->
    <section class="flex flex-col gap-6 md:gap-8">
      <h3 class="font-label-mono-bold text-label-mono-bold uppercase tracking-widest text-primary dark:text-primary-dark border-b border-border-main dark:border-border-main-dark pb-4">
        Also
      </h3>
      <ul class="flex flex-col gap-3 font-body-md text-body-md">
        <li>
          <a
            class="hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors px-2 py-1 -ml-2 inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark"
            href="/projects"
          >
            I build things → projects
          </a>
        </li>
        <li>
          <a
            class="hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors px-2 py-1 -ml-2 inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark"
            href="/podcasts"
          >
            I appear on podcasts &amp; talks → podcasts
          </a>
        </li>
        <li>
          <a
            class="hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors px-2 py-1 -ml-2 inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark"
            href="/services"
          >
            Available for consulting → services
          </a>
        </li>
        <li>
          <a
            class="hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors px-2 py-1 -ml-2 inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark"
            href="/about"
          >
            More about me → about
          </a>
        </li>
      </ul>
    </section>

  </div>
</Layout>

<script>
  document.getElementById("pronounce-btn")?.addEventListener("click", () => {
    new Audio("/assets/audio/name.m4a").play();
  });
</script>
