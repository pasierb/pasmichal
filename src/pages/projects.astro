---
import { Picture } from "astro:assets";
import { featuredProjects, projects } from "../collections/projects";
import Layout from "../layouts/main.astro";

const otherProjects = projects.filter((p) => !p.featured);
---

<Layout title="Projects | Michał Pasierbski">
  <article class="max-w-2xl mx-auto px-7 md:px-0 pt-12 md:pt-16 pb-24">

    <!-- Page header -->
    <header class="mb-16">
      <p class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-4">
        Projects
      </p>
      <h1 class="font-serif text-3xl md:text-5xl leading-[1.1] text-primary dark:text-primary-dark">
        Things I've built.
      </h1>
      <p class="font-sans text-base md:text-lg leading-relaxed text-secondary dark:text-secondary-dark mt-5">
        Startups, side projects, open source, family experiments. Some still alive, some retired.
      </p>
    </header>

    <!-- Featured -->
    {featuredProjects.length > 0 && (
      <section class="border-t border-border dark:border-border-dark pt-10 mb-16">
        <h2 class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-8">
          Featured
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-12">
          {featuredProjects.map((project) => (
            <li>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block"
              >
                {project.imageAsset && (
                  <div class="relative overflow-hidden rounded-md bg-gray-100 dark:bg-gray-800 aspect-[16/10] mb-4">
                    <Picture
                      src={project.imageAsset}
                      alt={project.name}
                      widths={[320, 480, 640, 960]}
                      sizes="(min-width: 640px) 320px, 100vw"
                      formats={["avif", "webp"]}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  </div>
                )}
                <h3 class="font-serif text-xl leading-tight text-primary dark:text-primary-dark">
                  <span class="marker-link">{project.name}</span>
                  {project.status !== "active" && (
                    <span class="font-sans text-xs uppercase tracking-wide text-muted dark:text-muted-dark ml-2">
                      ({project.status})
                    </span>
                  )}
                  <span class="font-sans text-xs text-muted ml-1 align-middle">↗</span>
                </h3>
                <p class="font-sans text-sm leading-relaxed text-secondary dark:text-secondary-dark mt-2">
                  {project.description}
                </p>
                {project.techStack.length > 0 && (
                  <p class="font-sans text-xs uppercase tracking-wide text-muted dark:text-muted-dark mt-3">
                    {project.techStack.join(" · ")}
                  </p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- More projects -->
    {otherProjects.length > 0 && (
      <section class="border-t border-border dark:border-border-dark pt-10">
        <h2 class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-6">
          More projects
        </h2>
        <ul class="divide-y divide-border dark:divide-border-dark">
          {otherProjects.map((project) => (
            <li>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="grid grid-cols-[5rem_1fr] md:grid-cols-[6rem_1fr] gap-4 py-4 group"
              >
                <span class="font-sans text-xs uppercase tracking-wide text-muted dark:text-muted-dark self-baseline pt-1">
                  {project.status}
                </span>
                <div>
                  <span class="font-sans text-base text-primary dark:text-primary-dark">
                    <span class="marker-link">{project.name}</span>
                    <span class="font-sans text-xs text-muted ml-1 align-middle">↗</span>
                  </span>
                  <p class="font-sans text-sm leading-relaxed text-secondary dark:text-secondary-dark mt-1">
                    {project.description}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </article>
</Layout>
