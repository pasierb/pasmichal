---
import { Image } from "astro:assets";
import Layout from "../layouts/main.astro";
import vibeIssue1 from "../assets/images/vibefix/vibe_issue_1.png";

const services = [
  {
    title: "Security Audit",
    description:
      "A thorough examination of your application to identify vulnerabilities and recommend robust protection strategies.",
  },
  {
    title: "Infrastructure Audit",
    description:
      "An in-depth analysis of your underlying infrastructure to ensure optimal performance, scalability, and reliability.",
  },
  {
    title: "Code Quality Audit",
    description:
      "A detailed review of your codebase to pinpoint areas for improvement in readability, maintainability, and best practices.",
  },
  {
    title: "AI Tooling Setup & Integration",
    description:
      "Expert assistance in setting up and integrating advanced AI-powered development tools (Cursor, Claude Code, Gemini CLI, Windsurf) to significantly enhance your team's code quality and development workflow.",
  },
  {
    title: "Strategic Improvement Plan",
    description:
      "A tailored, actionable roadmap outlining clear steps and recommendations to address identified areas and achieve your application's full potential.",
  },
];
---

<Layout title="Fix the Vibe — services | Michał Pasierbski">
  <article class="max-w-2xl mx-auto px-7 md:px-0 pt-12 md:pt-16 pb-24">

    <!-- Page header -->
    <header class="mb-16">
      <p class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-4">
        Services
      </p>
      <h1 class="font-serif text-3xl md:text-5xl leading-[1.1] text-primary dark:text-primary-dark">
        Fix the Vibe.
      </h1>
      <p class="font-sans text-base md:text-lg leading-relaxed text-secondary dark:text-secondary-dark mt-5">
        Comprehensive application optimization to elevate the quality, security, and efficiency of what you've built.
      </p>
    </header>

    <!-- When the vibe goes wrong -->
    <section class="border-t border-border dark:border-border-dark pt-10 mb-16">
      <h2 class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-6">
        When the vibe goes wrong
      </h2>
      <p class="font-sans text-base md:text-lg leading-relaxed text-secondary dark:text-secondary-dark mb-8">
        When the vibe in your codebase goes wrong, it affects everything — from development speed to team morale. Sound familiar?
      </p>
      <figure>
        <Image
          src={vibeIssue1}
          alt="Tweet showing vibe coding gone wrong"
          class="w-full rounded-md"
        />
        <figcaption class="font-sans text-xs uppercase tracking-wide text-muted dark:text-muted-dark mt-3">
          Exhibit A.
        </figcaption>
      </figure>
    </section>

    <!-- The offer -->
    <section class="border-t border-border dark:border-border-dark pt-10 mb-16">
      <h2 class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-6">
        The offer
      </h2>
      <p class="font-sans text-base md:text-lg leading-relaxed text-secondary dark:text-secondary-dark mb-10">
        A suite of engagements designed to elevate the quality, security, and efficiency of your application:
      </p>
      <ol class="space-y-8">
        {services.map((service, index) => (
          <li class="grid grid-cols-[3rem_1fr] gap-4">
            <span class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark pt-1.5">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-serif text-xl leading-tight text-primary dark:text-primary-dark">
                {service.title}
              </h3>
              <p class="font-sans text-sm md:text-base leading-relaxed text-secondary dark:text-secondary-dark mt-2">
                {service.description}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Get started -->
    <section class="border-t border-border dark:border-border-dark pt-10 mb-16">
      <h2 class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-6">
        Get started
      </h2>
      <p class="font-serif text-2xl md:text-3xl leading-tight text-primary dark:text-primary-dark mb-3">
        Ready to fix the vibe?
      </p>
      <p class="font-sans text-base leading-relaxed text-secondary dark:text-secondary-dark mb-2">
        Let's optimize your application and enhance your development workflow.
      </p>
      <p class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-8">
        Only 7 spots left.
      </p>
      <script async src="https://js.stripe.com/v3/buy-button.js"></script>
      <stripe-buy-button
        buy-button-id="buy_btn_1RgiH6LfFQVYhtFJA066934i"
        publishable-key="pk_live_51Rgh1OLfFQVYhtFJlN9t8nlNXGg7t7KpOP0XUBYF6jueosXcoTWe7PDeOe2Zr541whbR8GxmcRBPE1SLTm0G2e4U00fCUpaj8B"
      >
      </stripe-buy-button>
    </section>

    <!-- Your expert -->
    <section class="border-t border-border dark:border-border-dark pt-10">
      <h2 class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-5">
        Your expert
      </h2>
      <p class="font-sans text-base leading-relaxed text-secondary dark:text-secondary-dark mb-4">
        15+ years building software — startups, corporations, big tech.
      </p>
      <a href="/about" class="font-sans text-base text-primary dark:text-primary-dark marker-link">
        More about me <span class="text-secondary dark:text-secondary-dark">→ about</span>
      </a>
    </section>

  </article>
</Layout>
