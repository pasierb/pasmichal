---
import { Image } from "astro:assets";
import vibeIssue1 from "../assets/images/vibefix/vibe_issue_1.png";
import JsonLd from "../components/json-ld.astro";
import Layout from "../layouts/main.astro";
import { graph, service } from "../lib/schema";

const services = [
	{
		title: "Security Audit",
		description:
			"A thorough examination of your application to identify vulnerabilities and recommend robust protection strategies.",
	},
	{
		title: "Infrastructure Audit",
		description:
			"An in-depth analysis of your underlying infrastructure to ensure optimal performance, scalability, and reliability.",
	},
	{
		title: "Code Quality Audit",
		description:
			"A detailed review of your codebase to pinpoint areas for improvement in readability, maintainability, and best practices.",
	},
	{
		title: "AI Tooling Setup & Integration",
		description:
			"Expert assistance in setting up and integrating advanced AI-powered development tools (Cursor, Claude Code, Gemini CLI, Windsurf) to significantly enhance your team's code quality and development workflow.",
	},
	{
		title: "Strategic Improvement Plan",
		description:
			"A tailored, actionable roadmap outlining clear steps and recommendations to address identified areas and achieve your application's full potential.",
	},
];
---

<Layout
  title="Fix the Vibe — Vibe-Code Cleanup & Code Audits"
  description="AI-generated code that shipped fast and broke faster? I audit security, infrastructure and code quality, then hand your team a plan they can actually execute."
>
  <Fragment slot="meta-tags">
    <JsonLd data={graph(service(services))} />
  </Fragment>

  <div class="w-full max-w-[1200px] mx-auto px-6 md:px-12 lg:px-24 py-12 md:py-20 flex flex-col gap-12 md:gap-16">

    <!-- Page header -->
    <header class="flex flex-col gap-2">
      <span class="font-label-mono text-label-mono text-primary dark:text-primary-dark uppercase border border-border-main dark:border-border-main-dark px-2 py-1 self-start inline-block">
        Services
      </span>
      <h1 class="font-headline-xl-mobile md:font-headline-xl text-primary dark:text-primary-dark mt-2">
        Fix the Vibe.
      </h1>
      <p class="font-body-lg text-secondary dark:text-secondary-dark max-w-2xl mt-2">
        Comprehensive application optimization to elevate the quality, security, and efficiency of what you've built.
      </p>
    </header>

    <!-- When the vibe goes wrong -->
    <section class="flex flex-col gap-6">
      <div class="border-b border-border-main dark:border-border-main-dark pb-3">
        <h2 class="font-label-mono-bold text-label-mono-bold uppercase tracking-widest text-primary dark:text-primary-dark">
          When the vibe goes wrong
        </h2>
      </div>
      <p class="font-body-md text-secondary dark:text-secondary-dark max-w-3xl">
        When the vibe in your codebase goes wrong, it affects everything — from development speed to team morale. Sound familiar?
      </p>
      <figure class="border border-border-main dark:border-border-main-dark overflow-hidden max-w-3xl">
        <Image
          src={vibeIssue1}
          alt="Tweet showing vibe coding gone wrong"
          layout="constrained"
          width={672}
          widths={[672, 1008]}
          sizes="(min-width: 768px) 672px, 100vw"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
          class="w-full h-auto"
        />
        <figcaption class="font-label-mono text-xs uppercase tracking-wider text-secondary dark:text-secondary-dark p-3 border-t border-border-main dark:border-border-main-dark bg-surface-container-low dark:bg-surface-container-low-dark">
          Exhibit A.
        </figcaption>
      </figure>
    </section>

    <!-- The offer -->
    <section class="flex flex-col gap-6">
      <div class="border-b border-border-main dark:border-border-main-dark pb-3">
        <h2 class="font-label-mono-bold text-label-mono-bold uppercase tracking-widest text-primary dark:text-primary-dark">
          The offer
        </h2>
      </div>
      <p class="font-body-md text-secondary dark:text-secondary-dark max-w-3xl">
        A suite of engagements designed to elevate the quality, security, and efficiency of your application:
      </p>
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((service, index) => (
          <li class="border border-border-main dark:border-border-main-dark p-6 flex flex-col justify-between">
            <div>
              <span class="font-label-mono text-xs uppercase tracking-widest border border-border-main dark:border-border-main-dark px-2 py-0.5 inline-block mb-3">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="font-headline-lg text-xl text-primary dark:text-primary-dark font-medium">
                {service.title}
              </h3>
              <p class="font-body-md text-sm text-secondary dark:text-secondary-dark mt-2">
                {service.description}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Get started -->
    <section class="border border-border-main dark:border-border-main-dark p-8 md:p-12 flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <span class="font-label-mono text-xs uppercase tracking-widest text-secondary dark:text-secondary-dark">
          Only 7 spots left
        </span>
        <h2 class="font-headline-lg text-2xl md:text-3xl text-primary dark:text-primary-dark">
          Ready to fix the vibe?
        </h2>
        <p class="font-body-md text-secondary dark:text-secondary-dark max-w-xl">
          Let's optimize your application and enhance your development workflow.
        </p>
      </div>
      <div class="pt-2">
        <script is:inline async src="https://js.stripe.com/v3/buy-button.js"></script>
        <stripe-buy-button
          buy-button-id="buy_btn_1RgiH6LfFQVYhtFJA066934i"
          publishable-key="pk_live_51Rgh1OLfFQVYhtFJlN9t8nlNXGg7t7KpOP0XUBYF6jueosXcoTWe7PDeOe2Zr541whbR8GxmcRBPE1SLTm0G2e4U00fCUpaj8B"
        >
        </stripe-buy-button>
      </div>
    </section>

    <!-- Your expert -->
    <section class="flex flex-col gap-6">
      <div class="border-b border-border-main dark:border-border-main-dark pb-3">
        <h2 class="font-label-mono-bold text-label-mono-bold uppercase tracking-widest text-primary dark:text-primary-dark">
          Your expert
        </h2>
      </div>
      <p class="font-body-md text-secondary dark:text-secondary-dark max-w-2xl">
        15+ years building software — startups, corporations, big tech.
      </p>
      <div>
        <a
          href="/about"
          class="hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors px-2 py-1 -ml-2 inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark font-body-md text-primary dark:text-primary-dark"
        >
          More about me → about
        </a>
      </div>
    </section>

  </div>
</Layout>
