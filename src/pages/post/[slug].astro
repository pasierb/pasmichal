---
import { getCollection, render } from "astro:content";
import JsonLd from "../../components/json-ld.astro";
import Layout from "../../layouts/post.astro";
import { deriveOgImage } from "../../lib/og";
import { blogPosting, breadcrumbs, graph } from "../../lib/schema";

export async function getStaticPaths() {
	const postEntries = await getCollection(
		"post",
		(entry) => !entry.data.externalUrl && !entry.data.draft,
	);
	return postEntries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pathname = `/post/${entry.id}`;

// Derived once here so og:image and the BlogPosting `image` agree. Falls back
// to the shared card when the post has no hero.
const og = await deriveOgImage(entry.data.heroImage);
---

<Layout
	frontmatter={entry.data}
	headings={headings}
	ogImage={og.src}
	ogImageWidth={og.width}
	ogImageHeight={og.height}
>
	<Fragment slot="meta-tags">
		<JsonLd
			data={graph(
				blogPosting({
					title: entry.data.title,
					description: entry.data.seoDescription ?? entry.data.description,
					pathname,
					pubDate: entry.data.pubDate,
					updatedDate: entry.data.updatedDate,
					image: og.src,
					tags: entry.data.tags,
				}),
				breadcrumbs([
					{ name: "Home", path: "/" },
					{ name: "Writing", path: "/posts" },
					{ name: entry.data.title },
				]),
			)}
		/>
	</Fragment>
	<Content />
</Layout>
