---
import { getCollection } from "astro:content";
import Layout from "../layouts/main.astro";
import { formatMonth } from "../lib/date";

const sortedPosts = (
	await getCollection("post", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function postHref(post: (typeof sortedPosts)[number]) {
	return post.data.externalUrl ?? `/post/${post.id}`;
}

function isExternal(post: (typeof sortedPosts)[number]) {
	return !!post.data.externalUrl;
}

const postsByYear = sortedPosts.reduce<Record<number, typeof sortedPosts>>(
	(acc, post) => {
		const year = post.data.pubDate.getUTCFullYear();
		acc[year] ??= [];
		acc[year].push(post);
		return acc;
	},
	{},
);

const years = Object.keys(postsByYear)
	.map(Number)
	.sort((a, b) => b - a);
---

<Layout
  title="Writing on AI, Engineering & Products"
  description="Essays on AI agents, software engineering and shipping products, written from 15+ years across startups and big tech. Pragmatic, opinionated, no fluff."
>
  <article class="max-w-2xl mx-auto px-7 md:px-0 pt-12 md:pt-16 pb-24">

    <!-- Page header -->
    <header class="mb-16">
      <p class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-4">
        Writing
      </p>
      <h1 class="font-serif text-3xl md:text-5xl leading-[1.1] text-primary dark:text-primary-dark">
        Thoughts, in long form.
      </h1>
      <p class="font-sans text-base md:text-lg leading-relaxed text-secondary dark:text-secondary-dark mt-5">
        Engineering, AI, building products, and everything in between.
      </p>
    </header>

    {years.map((year) => (
      <section class="border-t border-border dark:border-border-dark pt-10 mb-16 last:mb-0">
        <h2 class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-6">
          {year}
        </h2>
        <ul class="divide-y divide-border dark:divide-border-dark">
          {postsByYear[year].map((post) => (
            <li>
              <a
                href={postHref(post)}
                {...(isExternal(post) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                class="grid grid-cols-[5rem_1fr] md:grid-cols-[6rem_1fr] gap-4 py-3 group"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-sans text-sm text-muted dark:text-muted-dark self-baseline"
                >
                  {formatMonth(post.data.pubDate)}
                </time>
                <span class="font-sans text-base text-primary dark:text-primary-dark self-baseline">
                  <span class="marker-link">
                    {post.data.title}
                  </span>
                  {post.data.source && (
                    <span class="font-sans text-xs uppercase tracking-wide text-muted dark:text-muted-dark ml-2">
                      {post.data.source}
                    </span>
                  )}
                  {isExternal(post) && <span class="font-sans text-xs text-muted ml-1.5 align-middle">↗</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

  </article>
</Layout>
