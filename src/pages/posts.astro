---
import { getCollection } from "astro:content";
import Layout from "../layouts/main.astro";
import { formatMonth } from "../lib/date";

const sortedPosts = (
	await getCollection("post", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function postHref(post: (typeof sortedPosts)[number]) {
	return post.data.externalUrl ?? `/post/${post.id}`;
}

function isExternal(post: (typeof sortedPosts)[number]) {
	return !!post.data.externalUrl;
}

const postsByYear = sortedPosts.reduce<Record<number, typeof sortedPosts>>(
	(acc, post) => {
		const year = post.data.pubDate.getUTCFullYear();
		acc[year] ??= [];
		acc[year].push(post);
		return acc;
	},
	{},
);

const years = Object.keys(postsByYear)
	.map(Number)
	.sort((a, b) => b - a);
---

<Layout
  title="Writing on AI, Engineering & Products"
  description="Essays on AI agents, software engineering and shipping products, written from 15+ years across startups and big tech. Pragmatic, opinionated, no fluff."
>
  <div class="w-full max-w-[1200px] mx-auto px-6 md:px-12 lg:px-24 py-12 md:py-20 flex flex-col gap-12 md:gap-16">

    <!-- Page header -->
    <header class="flex flex-col gap-2">
      <span class="font-label-mono text-label-mono text-primary dark:text-primary-dark uppercase border border-border-main dark:border-border-main-dark px-2 py-1 self-start inline-block">
        Writing
      </span>
      <h1 class="font-headline-xl-mobile md:font-headline-xl text-primary dark:text-primary-dark mt-2">
        Thoughts, in long form.
      </h1>
      <p class="font-body-lg text-secondary dark:text-secondary-dark max-w-2xl mt-2">
        Engineering, AI, building products, and everything in between.
      </p>
    </header>

    {years.map((year) => (
      <section class="flex flex-col gap-6">
        <div class="border-b border-border-main dark:border-border-main-dark pb-3">
          <h2 class="font-label-mono-bold text-label-mono-bold uppercase tracking-widest text-primary dark:text-primary-dark">
            {year}
          </h2>
        </div>
        <ul class="flex flex-col gap-4 md:gap-5">
          {postsByYear[year].map((post) => (
            <li class="group">
              <a
                href={postHref(post)}
                {...(isExternal(post) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-8"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-label-mono text-label-mono text-secondary dark:text-secondary-dark w-32 shrink-0"
                >
                  {formatMonth(post.data.pubDate)}
                </time>
                <span class="font-body-lg text-body-lg text-primary dark:text-primary-dark group-hover:underline decoration-1 underline-offset-4">
                  {post.data.title}
                  {post.data.source && (
                    <span class="font-label-mono text-[11px] uppercase tracking-wider border border-border dark:border-border-dark px-1.5 py-0.5 text-secondary dark:text-secondary-dark ml-2">
                      {post.data.source}
                    </span>
                  )}
                  {isExternal(post) && <span class="font-mono text-xs text-muted dark:text-muted-dark ml-1.5 align-middle">↗</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

  </div>
</Layout>
