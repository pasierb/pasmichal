---
import Layout from "../layouts/main.astro";
---

<Layout
  title="Page not found — Michał Pasierbski"
  description="That page does not exist. Head back to the writing, the projects, or the homepage of Michał Pasierbski, engineering leader and AI consultant in Zurich."
  noindex
>
  <div class="w-full max-w-[1200px] mx-auto px-6 md:px-12 lg:px-24 py-12 md:py-20 flex flex-col gap-12 md:gap-16">
    <header class="flex flex-col gap-2">
      <span class="font-label-mono text-label-mono text-primary dark:text-primary-dark uppercase border border-border-main dark:border-border-main-dark px-2 py-1 self-start inline-block">
        404
      </span>
      <h1 class="font-headline-xl-mobile md:font-headline-xl text-primary dark:text-primary-dark mt-2">
        This page doesn't exist.
      </h1>
      <p class="font-body-lg text-secondary dark:text-secondary-dark max-w-2xl mt-2">
        Moved, renamed, or never there in the first place. Try one of these instead.
      </p>
    </header>

    <!-- Outbound links recycle crawl equity from dead inbound links -->
    <section class="flex flex-col gap-6">
      <div class="border-b border-border-main dark:border-border-main-dark pb-3">
        <h2 class="font-label-mono-bold text-label-mono-bold uppercase tracking-widest text-primary dark:text-primary-dark">
          Navigation
        </h2>
      </div>
      <ul class="flex flex-col gap-3 font-body-md text-body-md">
        <li>
          <a
            href="/"
            class="hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors px-2 py-1 -ml-2 inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark text-primary dark:text-primary-dark"
          >
            Homepage →
          </a>
        </li>
        <li>
          <a
            href="/posts"
            class="hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors px-2 py-1 -ml-2 inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark text-primary dark:text-primary-dark"
          >
            Writing →
          </a>
        </li>
        <li>
          <a
            href="/projects"
            class="hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors px-2 py-1 -ml-2 inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark text-primary dark:text-primary-dark"
          >
            Projects →
          </a>
        </li>
        <li>
          <a
            href="/services"
            class="hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors px-2 py-1 -ml-2 inline-block border border-transparent hover:border-border-main dark:hover:border-border-main-dark text-primary dark:text-primary-dark"
          >
            Fix the Vibe →
          </a>
        </li>
      </ul>
    </section>
  </div>
</Layout>
