---
import Layout from "../layouts/main.astro";
---

<Layout
  title="Page not found — Michał Pasierbski"
  description="That page does not exist. Head back to the writing, the projects, or the homepage of Michał Pasierbski, engineering leader and AI consultant in Zurich."
  noindex
>
  <article class="max-w-2xl mx-auto px-7 md:px-0 pt-12 md:pt-16 pb-24">
    <header class="mb-12">
      <p class="font-sans text-xs uppercase tracking-widest text-muted dark:text-muted-dark mb-4">
        404
      </p>
      <h1 class="font-serif text-3xl md:text-5xl leading-[1.1] text-primary dark:text-primary-dark">
        This page doesn't exist.
      </h1>
      <p class="font-sans text-base md:text-lg leading-relaxed text-secondary dark:text-secondary-dark mt-5">
        Moved, renamed, or never there in the first place. Try one of these instead.
      </p>
    </header>

    <!-- Outbound links recycle crawl equity from dead inbound links -->
    <section class="border-t border-border dark:border-border-dark pt-10">
      <ul class="space-y-2">
        <li>
          <a href="/" class="font-sans text-base text-primary dark:text-primary-dark marker-link">
            Homepage
          </a>
        </li>
        <li>
          <a href="/posts" class="font-sans text-base text-primary dark:text-primary-dark marker-link">
            Writing
          </a>
        </li>
        <li>
          <a href="/projects" class="font-sans text-base text-primary dark:text-primary-dark marker-link">
            Projects
          </a>
        </li>
        <li>
          <a href="/services" class="font-sans text-base text-primary dark:text-primary-dark marker-link">
            Fix the Vibe
          </a>
        </li>
      </ul>
    </section>
  </article>
</Layout>
