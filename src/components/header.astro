---
import menus from "../collections/menu.json";
import Logo from "../components/logo.astro";

const pathname = Astro.url.pathname;
---

<nav class="bg-background dark:bg-background-dark border-b border-border-main dark:border-border-main-dark w-full sticky top-0 z-50">
  <div
    class="flex justify-between items-center w-full px-6 md:px-12 lg:px-24 py-5 md:py-6 max-w-[1200px] mx-auto"
  >
    <!-- Left: Logo -->
    <Logo />

    <!-- Right: Nav links & Controls -->
    <div class="flex items-center gap-6">
      <nav class="hidden md:flex items-center gap-6 font-label-mono text-label-mono">
        {
          menus.map((menu) => {
            const isActive = pathname === menu.url || pathname.startsWith(`${menu.url}/`);
            return (
              <a
                href={menu.url}
                class:list={[
                  "transition-colors duration-100 px-2 py-1",
                  isActive
                    ? "bg-primary text-on-primary dark:bg-primary-dark dark:text-on-primary-dark font-label-mono-bold"
                    : "text-on-surface-variant dark:text-on-surface-variant-dark hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark",
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {menu.name}
              </a>
            );
          })
        }
      </nav>

      <!-- Dark mode toggle -->
      <button
        id="darkToggle"
        type="button"
        aria-label="Toggle theme"
        class="flex items-center justify-center p-1.5 text-primary dark:text-primary-dark hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors duration-100 cursor-pointer"
      >
        <svg
          class="w-4 h-4 transition duration-500 transform ease"
          id="sun"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <svg
          class="hidden w-4 h-4 transition duration-500 transform ease"
          id="moon"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
        <span class="hidden">
          <span id="dayText">Day mode</span>
          <span id="nightText" class="hidden">Night mode</span>
        </span>
      </button>

      <!-- Mobile menu button -->
      <button
        id="mobileMenuBtn"
        type="button"
        class="md:hidden text-primary dark:text-primary-dark font-label-mono text-label-mono border border-border-main dark:border-border-main-dark px-3 py-1 hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark transition-colors duration-100"
        aria-label="Toggle menu"
      >
        Menu
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobileMenu"
    class="md:hidden bg-background dark:bg-background-dark border-t border-border-main dark:border-border-main-dark px-6 md:px-12 font-label-mono text-label-mono overflow-hidden transition-all duration-150 ease-in-out max-h-0 opacity-0 pt-0 pb-0"
  >
    {
      menus.map((menu) => {
        const isActive = pathname === menu.url || pathname.startsWith(`${menu.url}/`);
        return (
          <a
            href={menu.url}
            class:list={[
              "block py-2 my-1 px-2 transition-colors duration-100",
              isActive
                ? "bg-primary text-on-primary dark:bg-primary-dark dark:text-on-primary-dark font-label-mono-bold"
                : "text-on-surface-variant dark:text-on-surface-variant-dark hover:bg-primary hover:text-on-primary dark:hover:bg-primary-dark dark:hover:text-on-primary-dark",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {menu.name}
          </a>
        );
      })
    }
  </nav>
</nav>

<script is:inline>
  document.getElementById('mobileMenuBtn')?.addEventListener('click', () => {
    const menu = document.getElementById('mobileMenu');
    const btn = document.getElementById('mobileMenuBtn');
    const isOpen = menu?.classList.contains('max-h-0');

    if (isOpen) {
      menu?.classList.remove('max-h-0', 'opacity-0', 'pt-0', 'pb-0');
      menu?.classList.add('max-h-96', 'opacity-100', 'pt-2', 'pb-4');
      if (btn) btn.textContent = 'Close';
    } else {
      menu?.classList.remove('max-h-96', 'opacity-100', 'pt-2', 'pb-4');
      menu?.classList.add('max-h-0', 'opacity-0', 'pt-0', 'pb-0');
      if (btn) btn.textContent = 'Menu';
    }
  });
</script>
