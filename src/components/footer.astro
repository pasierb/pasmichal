---
import socials from "../collections/socials.json";

const isOutbound = (social: (typeof socials)[number]) =>
	!social.url.startsWith("mailto:") && !social.download;
---

<footer class="bg-background dark:bg-background-dark border-t border-border-main dark:border-border-main-dark w-full mt-auto">
  <div class="w-full px-6 md:px-12 lg:px-24 py-10 md:py-12 max-w-[1200px] mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
    <div class="flex flex-col gap-2">
      <span class="font-label-mono-bold text-label-mono-bold text-primary dark:text-primary-dark">
        Michał Pasierbski
      </span>
      <span class="font-label-mono text-label-mono text-text-muted dark:text-text-muted-dark">
        &copy; {new Date().getFullYear()} Michał Pasierbski. AI Product Engineering.
      </span>
    </div>
    <div class="flex flex-wrap items-center gap-6 font-label-mono text-label-mono">
      <a
        href="/rss.xml"
        class="text-text-muted dark:text-text-muted-dark hover:underline decoration-1 underline-offset-4 transition-colors hover:text-primary dark:hover:text-primary-dark"
      >
        RSS
      </a>
      {socials.map((social) => (
        <a
          href={social.url}
          target={isOutbound(social) ? "_blank" : undefined}
          rel={isOutbound(social) ? "me noopener noreferrer" : undefined}
          download={social.download ? "" : undefined}
          class="text-text-muted dark:text-text-muted-dark hover:underline decoration-1 underline-offset-4 transition-colors hover:text-primary dark:hover:text-primary-dark"
        >
          {social.label.replace(" (Twitter)", "")}
        </a>
      ))}
    </div>
  </div>
</footer>
