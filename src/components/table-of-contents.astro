---
interface Props {
	headings: { depth: number; slug: string; text: string }[];
	maxDepth?: number;
}

// Mirrors the old remark-toc config: `{ heading: "On this page", maxDepth: 3 }`.
// Post titles are rendered by the layout, so markdown headings start at depth 2.
const { headings, maxDepth = 3 } = Astro.props;
const items = headings.filter((h) => h.depth > 1 && h.depth <= maxDepth);
---

{
  items.length > 0 && (
    <nav
      aria-labelledby="toc-heading"
      class="py-6 border-y border-border-main dark:border-border-main-dark"
    >
      <h2
        id="toc-heading"
        class="font-label-mono-bold text-label-mono-bold uppercase tracking-widest text-primary dark:text-primary-dark mb-4"
      >
        On this page
      </h2>
      <ul class="space-y-2 font-label-mono text-label-mono">
        {items.map((heading) => (
          <li class:list={[heading.depth > 2 && "ml-4"]}>
            <a
              href={`#${heading.slug}`}
              class="text-secondary dark:text-secondary-dark hover:underline hover:text-primary dark:hover:text-primary-dark transition-colors"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
