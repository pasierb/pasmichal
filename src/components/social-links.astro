---
import socials from "../collections/socials.json";

interface Props {
	size?: "sm" | "md";
}

const { size = "md" } = Astro.props;
const sizeClass = size === "sm" ? "w-[15px] h-[15px]" : "w-4 h-4";

// mailto: and internal links open in place; external links open in a new tab.
const isOutbound = (social: (typeof socials)[number]) =>
	!social.url.startsWith("mailto:") && !social.url.startsWith("/");
---

{
  socials.map((social) => (
    <a
      href={social.url}
      target={isOutbound(social) ? "_blank" : undefined}
      rel={isOutbound(social) ? "me noopener noreferrer" : undefined}
      class="text-muted dark:text-muted-dark hover:text-primary dark:hover:text-primary-dark transition-colors"
      aria-label={social.label}
    >
      <Fragment set:html={social.icon.replace(/<svg /, `<svg class="${sizeClass}" `)} />
    </a>
  ))
}
